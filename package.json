{
  "name": "curie-study-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A free, local desktop study companion.",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "preview": "node src/preview/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "build": "node --check src/main/main.js && node --check src/core/index.js && node --check src/core/pet-behavior.js && node --check src/core/pet-calm.js && node --check src/core/pet-position.js && node --check src/core/pet-gaze.js && node --check src/renderer/pet.js && node --check src/renderer/debug-overlay.js && node --check src/main/debug-overlay-preload.js && node --check src/preview/server.js",
    "doctor": "node scripts/doctor.js",
    "test:agent-mock": "node tests/agent-mock-e2e.js",
    "eval": "node evals/run.js",
    "eval:live": "node evals/run.js --live",
    "package:mac": "electron-builder --mac dmg zip --universal",
    "package:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.31.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "com.aanyabajpai.curie",
    "productName": "Curie",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "mac": {
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
